APP_NAME="Q8 Private Resort"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_DISPLAY_TIMEZONE=Asia/Manila

PRIMARY_ADMIN_NAME="Renante Barcoma"
PRIMARY_ADMIN_EMAIL=renantebarcoma1@gmail.com
PRIMARY_ADMIN_PASSWORD=Rbarcoma*123
# Required: use a strong password with at least 12 characters, uppercase,
# lowercase, number, and special character.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_DISK=public
# Local uploads are served by /media/... without a storage symlink.
# Only set these when intentionally using a different storage root/static server.
# PUBLIC_DISK_ROOT=/home/username/domains/your-domain.com/public_html/storage
# PUBLIC_DISK_URL="${APP_URL}/storage"

QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
